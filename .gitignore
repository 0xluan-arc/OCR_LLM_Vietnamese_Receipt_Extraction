# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
*.env
secrets.json
*.pem
*.key

# IDEs & Editor configs
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
ehthumbs.db
Desktop.ini

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Large Datasets & Media (Không commit dữ liệu ảnh nhạy cảm lên Git)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/annotations/*
!data/annotations/.gitkeep
# Giữ lại các ảnh sample phi cá nhân hóa phục vụ test
!data/samples/.gitkeep

# Model weights, checkpoints & Large Artifacts
artifacts/*
!artifacts/.gitkeep
models/
*.pt
*.pth
*.bin
*.onnx
*.safetensors

# Experiment runs & logs
experiments/runs/*
!experiments/runs/.gitkeep
logs/
*.log
