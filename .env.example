# ==============================================================================
# RECEIPT INFORMATION EXTRACTION - ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép tệp này thành .env và điền các giá trị thích hợp nếu sử dụng LLM qua API.
# KHÔNG BAO GIỜ COMMIT TỆP .env CHỨA SECRET LÊN GIT REPOSITORY!
# ==============================================================================

# Cấu hình môi trường (development / testing / production)
APP_ENV=development
DEBUG=True

# Cấu hình OCR Engine: "dummy" (để test không cần cài OCR), "tesseract", "vietocr", "paddleocr"
OCR_ENGINE=dummy

# Đường dẫn cài đặt Tesseract nếu dùng trên Windows (mặc định: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Cấu hình LLM trích xuất (Tùy chọn cho B3/B4/B5)
# Nhà cung cấp: "none" (chỉ chạy Regex Baseline B1), "openai", "gemini", "ollama", "groq"
LLM_PROVIDER=none

# Model name tương ứng
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1

# Cấu hình ngưỡng kiểm tra ảnh
MAX_IMAGE_SIZE_MB=15
MIN_IMAGE_WIDTH=200
MIN_IMAGE_HEIGHT=200
BLUR_THRESHOLD=50.0
